# Cont Gateway — 部署環境變數範例
# 複製此檔案為 .env 並填入實際值後使用

# ── 應用程式 ────────────────────────────────────────────────────────────────
CONT_URL=https://cont.example.com
IMAGE_TAG=latest

# JWT Secret（必填，生產環境請使用隨機字串）
# 產生方式：openssl rand -hex 32
JWT_SECRET=

# ── 資料庫 ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=kongpass
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_PORT=6379

# ── 端口映射 ───────────────────────────────────────────────────────────────
ADMIN_API_PORT=18081
PROXY_PORT=18000
FRONTEND_PORT=18082

# ── CORS ─────────────────────────────────────────────────────────────────
CONT_CORS_ORIGIN=*

# ── 日誌格式 ───────────────────────────────────────────────────────────────
CONT_LOG_FORMAT=json
CONT_LOG_LEVEL=info
CONT_JSON_PRETTY=false
CONT_WRAP_ERRORS=true

# ── 通知 Webhooks ──────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=

# ── SMTP ─────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=